# Python interpreter and environment artifacts.
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/
ENV/
*.egg-info/
build/
dist/
*.app/
*.dmg
*.zip

# Test and coverage output.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/
test-results/

# Runtime state, logs, and local databases.
logs/
*.log
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.db-journal
backups/
diagnostics/
/runtime/
**/backups/
**/diagnostics/
**/runtime-state/
*.pid
*.sock

# Local credentials/configuration. Keep only an explicitly safe template.
.env
.env.*
!.env.example
*.local
*.local.*
*credentials*
*token-cache*
*cookies*
*.pem
*.key
*.p12
*.pfx

# Application-owned browser authentication/runtime data must never enter Git.
browser_profiles/
**/browser_profiles/
chrome-brain-profile/
**/chrome-brain-profile/
browser-profile/
**/browser-profile/
userData/
sessionData/
**/userData/
**/sessionData/
**/Cache/
**/cache/
DevToolsActivePort
**/DevToolsActivePort
*.storage-state.json
storage-state.json

# Desktop POC dependencies and generated packaging output.
**/node_modules/
desktop/dist/
desktop/out/
desktop/build/
desktop/coverage/

# Historical upstream checkouts are research material, not project source.
phase0_research/
cao-state/
tmux-state/
sandbox/**/image-lock.yaml

# macOS and editor-local metadata.
.DS_Store
**/.DS_Store
.AppleDouble
*.swp
*.swo
.idea/
.vscode/
